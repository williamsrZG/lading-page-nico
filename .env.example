# Facebook Pixel (Administrador de eventos > Origenes de datos > tu Pixel)
NEXT_PUBLIC_FB_PIXEL_ID=

# Numero de WhatsApp por defecto (se usa si todavia no se conecto Vercel KV
# o antes de guardar un numero desde el panel admin). Formato: codigo de pais + numero, sin + ni espacios.
# Ejemplo Argentina: 5491122334455
DEFAULT_PHONE=5491122334455

# Contrasena para entrar al panel /admin
ADMIN_PASSWORD=cambiar-esta-clave

# Cadena secreta aleatoria, solo se usa para firmar la sesion del admin
ADMIN_SESSION_SECRET=cambiar-por-un-string-random-largo

# Estas dos las completa Vercel automaticamente al conectar Vercel KV
# (Storage > Create Database > KV) desde el dashboard del proyecto.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
